{
  "manifest_version": 3,
  "name": "Meet Avatar Overlay",
  "version": "1.0",
  "description": "Custom talking, muted, and idle avatars per user in video meetings.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {"scripts": ["background.js"]},

  "action": {"default_popup": "popup.html"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
